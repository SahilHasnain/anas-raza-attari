{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.12.0"
    },
    "all": {
      "env": {
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "69907afc003b9e3d9152",
        "EXPO_PUBLIC_APPWRITE_DATABASE_ID": "main-db",
        "EXPO_PUBLIC_APPWRITE_NAATS_COLLECTION_ID": "naats",
        "EXPO_PUBLIC_APPWRITE_CHANNELS_COLLECTION_ID": "channels",
        "EXPO_PUBLIC_APPWRITE_LIVE_RADIO_COLLECTION_ID": "live_radio",
        "EXPO_PUBLIC_USE_SEMANTIC_SEARCH": "false",
        "EXPO_PUBLIC_DISABLE_SEARCH_SUGGESTIONS": "true",
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "69907afc003b9e3d9152",
        "EXPO_PUBLIC_APPWRITE_DATABASE_ID": "main-db",
        "EXPO_PUBLIC_APPWRITE_NAATS_COLLECTION_ID": "naats",
        "EXPO_PUBLIC_APPWRITE_CHANNELS_COLLECTION_ID": "channels",
        "EXPO_PUBLIC_APPWRITE_LIVE_RADIO_COLLECTION_ID": "live_radio",
        "EXPO_PUBLIC_USE_SEMANTIC_SEARCH": "false",
        "EXPO_PUBLIC_DISABLE_SEARCH_SUGGESTIONS": "true",
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "autoIncrement": false,
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://sgp.cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "69907afc003b9e3d9152",
        "EXPO_PUBLIC_APPWRITE_DATABASE_ID": "main-db",
        "EXPO_PUBLIC_APPWRITE_NAATS_COLLECTION_ID": "naats",
        "EXPO_PUBLIC_APPWRITE_CHANNELS_COLLECTION_ID": "channels",
        "EXPO_PUBLIC_APPWRITE_LIVE_RADIO_COLLECTION_ID": "live_radio",
        "EXPO_PUBLIC_USE_SEMANTIC_SEARCH": "false",
        "EXPO_PUBLIC_DISABLE_SEARCH_SUGGESTIONS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
